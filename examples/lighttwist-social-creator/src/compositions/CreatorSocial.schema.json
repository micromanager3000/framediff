{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hook-kicker": { "$ref": "#/$defs/text" },
    "hook-line-one": { "$ref": "#/$defs/text" },
    "hook-line-two": { "$ref": "#/$defs/text" },
    "reveal-line-one": { "$ref": "#/$defs/text" },
    "reveal-line-two": { "$ref": "#/$defs/text" },
    "proof-chip-one": { "$ref": "#/$defs/text" },
    "proof-chip-two": { "$ref": "#/$defs/text" },
    "end-brand": { "$ref": "#/$defs/text" },
    "end-line-one": { "$ref": "#/$defs/text" },
    "end-line-two": { "$ref": "#/$defs/text" },
    "end-cta": { "$ref": "#/$defs/text" },
    "end-url": { "$ref": "#/$defs/text" },
    "music-bed": { "$ref": "#/$defs/audio" },
    "reveal-shine": { "$ref": "#/$defs/audio" }
  },
  "$defs": {
    "text": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "format": "multiline"
        },
        "color": {
          "type": "string",
          "format": "color"
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "multipleOf": 0.01
        },
        "muted": {
          "type": "boolean"
        }
      }
    }
  }
}
