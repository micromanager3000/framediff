{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mark": { "$ref": "#/$defs/box", "title": "Aperture mark" },
    "kicker": { "$ref": "#/$defs/textBlock", "title": "Kicker" },
    "titleWipe": { "$ref": "#/$defs/box", "title": "Title frame" },
    "title": { "$ref": "#/$defs/textBlock", "title": "Title" },
    "rule": { "$ref": "#/$defs/box", "title": "Rule" },
    "lede": { "$ref": "#/$defs/textBlock", "title": "Lede" }
  },
  "$defs": {
    "box": {
      "type": "object",
      "properties": {
        "x": { "type": "number", "minimum": -960, "maximum": 1920 },
        "y": { "type": "number", "minimum": -540, "maximum": 1080 },
        "width": { "type": "number", "minimum": 2, "maximum": 1920 },
        "height": { "type": "number", "minimum": 1, "maximum": 1080 }
      }
    },
    "textBlock": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "title": "Copy", "format": "multiline" },
        "x": { "type": "number", "minimum": -960, "maximum": 1920 },
        "y": { "type": "number", "minimum": -540, "maximum": 1080 },
        "width": { "type": "number", "minimum": 80, "maximum": 1920 },
        "fontSize": { "type": "number", "minimum": 10, "maximum": 200 },
        "lineHeight": { "type": "number", "minimum": 0.7, "maximum": 2, "multipleOf": 0.01 },
        "letterSpacing": { "type": "number", "minimum": -12, "maximum": 24 },
        "color": { "type": "string", "format": "color" }
      }
    }
  }
}
