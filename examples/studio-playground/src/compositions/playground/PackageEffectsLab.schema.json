{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "$ref": "#/$defs/text" },
    "headline": {
      "allOf": [
        { "$ref": "#/$defs/text" },
        {
          "type": "object",
          "properties": {
            "animStartFrame": { "type": "number", "minimum": 0, "maximum": 240 },
            "animEndFrame": { "type": "number", "minimum": 0, "maximum": 240 },
            "distance": { "type": "number", "minimum": 0, "maximum": 300 },
            "stagger": { "type": "number", "minimum": 0, "maximum": 1, "multipleOf": 0.01 },
            "window": { "type": "number", "minimum": 0.01, "maximum": 1, "multipleOf": 0.01 }
          }
        }
      ]
    },
    "wipe": {
      "type": "object",
      "properties": {
        "wipe": { "type": "string", "enum": ["fast", "smooth"] },
        "wipeFrom": { "type": "number", "minimum": -240, "maximum": 240 },
        "wipeTo": { "type": "number", "minimum": -240, "maximum": 240 },
        "label": { "type": "string" },
        "title": { "type": "string" },
        "copy": { "type": "string", "format": "multiline" }
      }
    },
    "motion": { "$ref": "#/$defs/motion" },
    "spring": {
      "type": "object",
      "properties": {
        "delay": { "type": "number", "minimum": 0, "maximum": 240 },
        "from": { "type": "number", "minimum": 0, "maximum": 2, "multipleOf": 0.01 },
        "to": { "type": "number", "minimum": 0, "maximum": 2, "multipleOf": 0.01 },
        "damping": { "type": "number", "minimum": 0.1, "maximum": 100, "multipleOf": 0.1 },
        "stiffness": { "type": "number", "minimum": 0.1, "maximum": 500, "multipleOf": 0.1 },
        "rotationFrom": { "type": "number", "minimum": -720, "maximum": 720 },
        "rotationTo": { "type": "number", "minimum": -720, "maximum": 720 }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "multipleOf": 0.01 },
        "fadeFrom": { "type": "number", "minimum": 0, "maximum": 240 },
        "fadeTo": { "type": "number", "minimum": 0, "maximum": 240 }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "format": "multiline" },
        "color": { "type": "string", "format": "color" }
      }
    },
    "motion": {
      "type": "object",
      "properties": {
        "anchorX": { "type": "number" },
        "anchorY": { "type": "number" },
        "sourceWidth": { "type": "number", "minimum": 1 },
        "sourceHeight": { "type": "number", "minimum": 1 },
        "startFrame": { "type": "number" },
        "endFrame": { "type": "number" },
        "startX": { "type": "number" },
        "startY": { "type": "number" },
        "endX": { "type": "number" },
        "endY": { "type": "number" },
        "startScale": { "type": "number", "minimum": 0 },
        "endScale": { "type": "number", "minimum": 0 },
        "interpolation": { "type": "string", "enum": ["linear", "smooth"] },
        "path": { "type": "string" }
      }
    }
  }
}
