{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wash": { "$ref": "#/$defs/surface" },
    "glass": { "$ref": "#/$defs/surface" },
    "kicker": { "$ref": "#/$defs/text" },
    "title": { "$ref": "#/$defs/text" },
    "caption": { "$ref": "#/$defs/text" },
    "rank1": { "$ref": "#/$defs/text" },
    "rank2": { "$ref": "#/$defs/text" },
    "rank4": { "$ref": "#/$defs/text" },
    "badge": { "$ref": "#/$defs/text" },
    "grade": { "$ref": "#/$defs/grade" }
  },
  "$defs": {
    "text": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "format": "multiline" },
        "color": { "type": "string", "format": "color" }
      }
    },
    "surface": {
      "type": "object",
      "properties": {
        "background": { "type": "string", "format": "multiline" },
        "borderRadius": { "type": "number", "minimum": 0, "maximum": 200 },
        "blendMode": { "type": "string", "enum": ["normal", "screen", "multiply", "overlay"] }
      }
    },
    "grade": {
      "type": "object",
      "properties": {
        "gradeExposure": { "type": "number", "minimum": -2, "maximum": 2, "multipleOf": 0.01 },
        "gradeContrast": { "type": "number", "minimum": -1, "maximum": 1, "multipleOf": 0.01 },
        "gradeSaturation": { "type": "number", "minimum": 0, "maximum": 2, "multipleOf": 0.01 },
        "gradeTemperature": { "type": "number", "minimum": -1, "maximum": 1, "multipleOf": 0.01 },
        "gradeVignette": { "type": "number", "minimum": 0, "maximum": 1, "multipleOf": 0.01 }
      }
    }
  }
}
