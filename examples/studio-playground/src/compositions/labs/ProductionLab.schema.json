{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generatedTake": { "$ref": "#/$defs/media" },
    "introCopy": { "$ref": "#/$defs/box" },
    "kicker": { "$ref": "#/$defs/text" },
    "titleLead": { "$ref": "#/$defs/text" },
    "titleAccent": { "$ref": "#/$defs/text" },
    "summary": { "$ref": "#/$defs/text" },
    "graph1": { "$ref": "#/$defs/graphRow" },
    "graph2": { "$ref": "#/$defs/graphRow" },
    "graph3": { "$ref": "#/$defs/graphRow" },
    "graph4": { "$ref": "#/$defs/graphRow" },
    "chapters": {
      "type": "object",
      "properties": {
        "chapter0": { "$ref": "#/$defs/chapter" },
        "chapter1": { "$ref": "#/$defs/chapter" },
        "chapter2": { "$ref": "#/$defs/chapter" },
        "chapter3": { "$ref": "#/$defs/chapter" },
        "chapter4": { "$ref": "#/$defs/chapter" },
        "chapter5": { "$ref": "#/$defs/chapter" },
        "chapter6": { "$ref": "#/$defs/chapter" },
        "chapter7": { "$ref": "#/$defs/chapter" },
        "chapter8": { "$ref": "#/$defs/chapter" }
      }
    },
    "chapterSource": { "$ref": "#/$defs/text" },
    "audio": {
      "type": "object",
      "properties": {
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "multipleOf": 0.01 },
        "muted": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "text": { "type": "object", "properties": { "text": { "type": "string", "format": "multiline" } } },
    "box": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 }
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "src": { "type": "string", "format": "asset", "x-accept": "video" },
        "muted": { "type": "boolean" },
        "fit": { "type": "string", "enum": ["cover", "contain", "fill", "none"] }
      }
    },
    "graphRow": {
      "type": "object",
      "properties": {
        "number": { "type": "string" },
        "title": { "type": "string" },
        "surface": { "type": "string" }
      }
    },
    "chapter": {
      "type": "object",
      "properties": {
        "number": { "type": "string" },
        "title": { "type": "string" }
      }
    }
  }
}
