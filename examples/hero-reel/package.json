{
  "name": "@framediff/example-hero-reel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The full LightTwist reel rebuilt in FrameDiff from HERO-REEL-SPEC.md: the 22-shot EDL, graded footage (gold LUT), in-scene captions, lower-third, logo bumper, and end card.",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "npm run check"
  },
  "dependencies": {
    "@framediff/studio-model": "*",
    "@framediff/studio-ui": "*",
    "framediff": "*"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@webgpu/types": "^0.1.71",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
