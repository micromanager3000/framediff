{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cloth": {
      "type": "object",
      "title": "Cloth",
      "properties": {
        "x": { "type": "number", "title": "Canvas X", "minimum": -1280, "maximum": 1280, "multipleOf": 1 },
        "y": { "type": "number", "title": "Canvas Y", "minimum": -720, "maximum": 720, "multipleOf": 1 },
        "width": { "type": "number", "title": "Canvas width", "minimum": 1, "maximum": 2560, "multipleOf": 1 },
        "height": { "type": "number", "title": "Canvas height", "minimum": 1, "maximum": 1440, "multipleOf": 1 },
        "gravityY": { "type": "number", "title": "Gravity", "minimum": -20, "maximum": 10, "multipleOf": 0.1 },
        "windBase": { "type": "number", "title": "Wind", "minimum": 0, "maximum": 12, "multipleOf": 0.1 },
        "windGust": { "type": "number", "title": "Gust", "minimum": 0, "maximum": 8, "multipleOf": 0.1 },
        "damping": { "type": "number", "minimum": 0, "maximum": 0.2, "multipleOf": 0.001 },
        "stiffness": { "type": "number", "minimum": 0, "maximum": 1, "multipleOf": 0.01 },
        "shearStiffness": { "type": "number", "title": "Shear stiffness", "minimum": 0, "maximum": 1, "multipleOf": 0.01 },
        "bendStiffness": { "type": "number", "title": "Bend stiffness", "minimum": 0, "maximum": 1, "multipleOf": 0.01 },
        "substeps": { "type": "number", "minimum": 1, "maximum": 16, "multipleOf": 1 },
        "iterations": { "type": "number", "minimum": 1, "maximum": 24, "multipleOf": 1 },
        "pins": { "type": "string", "enum": ["none", "top", "corners"] },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1, "multipleOf": 0.01 },
        "metalness": { "type": "number", "minimum": 0, "maximum": 1, "multipleOf": 0.01 },
        "cameraFov": { "type": "number", "title": "Camera FOV", "minimum": 10, "maximum": 90, "multipleOf": 1 }
      }
    },
    "art": {
      "type": "object",
      "title": "Art direction",
      "properties": {
        "accent": { "type": "string", "format": "color" },
        "secondary": { "type": "string", "format": "color" },
        "showGrid": { "type": "boolean", "title": "Show grid" }
      }
    }
  }
}
