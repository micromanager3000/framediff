{
  "name": "framediff-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source FrameDiff engine, Studio packages, and example projects.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @framediff/example-first-light",
    "dev:playground": "npm run dev --workspace @framediff/example-studio-playground",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "check:bundles": "node scripts/check-bundle-budgets.mjs",
    "check:studio-css": "node scripts/check-studio-css-isolation.mjs",
    "check:ui": "node scripts/check-ui-conventions.mjs && npm run check:studio-css",
    "check": "npm run check:ui && npm run typecheck && npm run test:unit && npm run build && npm run check:bundles"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "vitest": "^4.1.10"
  }
}
